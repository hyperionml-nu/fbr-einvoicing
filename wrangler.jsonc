{
  "name": "fbreinvoicing1",
  "compatibility_date": "2026-06-17",
  "main": "./apps/worker/index.js",
  "build": {
    "command": "npm run cloudflare:build"
  },
  "assets": {
    "directory": "./apps/frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/api-docs", "/api-docs/*"]
  }
}
